#!/bin/sh

# Clustering, which this app needs and did not have.
#
# Windows of one session mirror each other over Phoenix.PubSub, and PubSub only
# reaches processes on nodes that are actually connected. A release starts with
# no distribution unless told otherwise: the node is not even named, so
# DNSCluster has nothing to join and two windows landing on different machines
# would silently fail to sync — worse than not syncing at all, because it would
# work about half the time.
#
# Fly's private network is IPv6-only, hence the proto_dist flag; without it the
# nodes are named and still cannot reach each other.
if [ -n "$FLY_PRIVATE_IP" ]; then
  export ERL_AFLAGS="-proto_dist inet6_tcp"
  export RELEASE_DISTRIBUTION="name"
  export RELEASE_NODE="$RELEASE_NAME@$FLY_PRIVATE_IP"
fi
